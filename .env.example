# Cineverse V2 — variables serveur uniquement
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://cineverse:change-me@localhost:5432/cineverse
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_DAYS=30
SUPER_ADMIN_EMAILS=admin@example.com

# Stockage local sur le disque du serveur (chemin relatif à la racine du processus ou chemin absolu)
LOCAL_STORAGE_DIR=./storage

# Lecteurs films/séries intégrés en iframe : hôtes exacts autorisés, séparés par des virgules.
# Laisser vide tant que les domaines de lecteurs ne sont pas validés.
IFRAME_ALLOWED_HOSTS=

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/v1/auth/discord/callback

# TMDB metadata API (v3 key or v4 read access token)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Redis, error tracking and product analytics (optional)
REDIS_URL=
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
